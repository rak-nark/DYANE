# =============================================================================
#  Dynatrace - Configuración del entorno de trabajo
#  Copia este archivo a .env y completa los valores. NUNCA comitees .env.
# =============================================================================

# Identificador de tu entorno SaaS Dynatrace (subdominio de tu tenant).
# Ejemplo: si tu URL es https://abc12345.apps.dynatrace.com -> abc12345
DT_ENVIRONMENT_ID=

# URL completa del entorno (se construye automáticamente si dejas DT_ENVIRONMENT_ID).
# Ejemplo: https://abc12345.apps.dynatrace.com
DT_ENVIRONMENT_URL=

# URL del servidor MCP remoto de Dynatrace.
# Normalmente no necesitas definirla porque `dtx mcp` la deriva desde DT_ENVIRONMENT_URL:
# https://<env-id>.apps.dynatrace.com/platform-reserved/mcp-gateway/v0.1/servers/dynatrace-mcp/mcp
DT_MCP_SERVER_URL=

# Platform Token (recomendado para API y MCP). Formato: dt0s16.<usuario>.<clave>
# Se obtiene en: https://myaccount.dynatrace.com/platformTokens
# Scopes mínimos para MCP: mcp-gateway:servers:read, mcp-gateway:servers:invoke,
#   ai:operator:execute, storage:logs:read, storage:metrics:read, storage:entities:read
DT_PLATFORM_TOKEN=

# OAuth client (Client Credentials o Authorization Code) - alternativo al platform token.
# client_id (formato dt0s02.<clave>) y client_secret (solo se muestra una vez al crear).
DT_OAUTH_CLIENT_ID=
DT_OAUTH_CLIENT_SECRET=

# URN de la cuenta (solo necesario para flujo client credentials).
# Ejemplo: urn:dtaccount:<uuid>
DT_ACCOUNT_URN=

# Prefijo de comando para proxying a dtctl (dejar vacío si dtctl está en PATH)
DTCTL_BIN=dtctl

# Output por defecto del CLI: table | json | raw
DTX_OUTPUT=json
