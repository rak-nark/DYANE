{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dynatrace-mcp": {
      "type": "remote",
      "url": "https://<your-env-id>.apps.dynatrace.com/platform-reserved/mcp-gateway/v0.1/servers/dynatrace-mcp/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer <DT_PLATFORM_TOKEN>"
      }
    }
  }
}